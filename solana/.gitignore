*.so

# Anchor IDL output for typescript clients — regenerable
# (Comment out if you intentionally commit it for FE consumption)
# target/idl/

# Node deps for migration scripts (`anchor migrate`)
node_modules/
yarn-error.log
.yarn/

# OS / IDE noise
.DS_Store
.idea/
.vscode/
