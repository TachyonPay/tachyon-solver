# Build stage
FROM golang:1.23-alpine AS builder

# Install build dependencies
RUN apk add --no-cache gcc musl-dev git

WORKDIR /app

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the solver binary
RUN CGO_ENABLED=1 GOOS=linux go build -a -installsuffix cgo -o solver ./cmd/solver

# Runtime stage
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN adduser -D -g '' tachyon
WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/solver .

# Copy contracts ABI
COPY --from=builder /app/contracts ./contracts

# Create data directory for PebbleDB
RUN mkdir -p /data && chown -R tachyon:tachyon /data

# Switch to non-root user
USER tachyon

# Environment variables
ENV DB_PATH=/data/solver
ENV GIN_MODE=release

# Expose solver port
EXPOSE 8081

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8081/health || exit 1

# Run solver
ENTRYPOINT ["./solver"]
