# tachyon-prod env template
#
# Copy to `.env` and fill in. Both solver and relayer read this file.
# CHAIN_COUNT = number of chains configured below.
#
# Each chain is described by `CHAIN_<i>_*` env vars where i ∈ [1, CHAIN_COUNT].
# Set `CHAIN_<i>_TYPE` to "evm" (default) or "solana".

# ---- global ----
CHAIN_COUNT=3
RELAYER_URL=http://localhost:3000
SOLVER_PORT=3001
RELAYER_PORT=3000
DB_PATH=./data
ADMIN_API_KEY=                     # leave blank to disable admin routes

# Solver wallet (secp256k1, hex without 0x). Used for all configured EVM chains.
PRIVATE_KEY=

# Solver Solana wallet (base58 ed25519 secret, the format `solana-keygen` writes
# to id.json — full 64-byte secret, not just the seed). REQUIRED if any chain
# below has TYPE=solana. Generate with:
#   solana-keygen new --outfile solver-solana.json
#   go run ./cmd/solana-key-to-base58 solver-solana.json
SOLVER_SOLANA_PRIVATE_KEY=

# Relayer Solana wallet — separate from the solver. Required only when the
# relayer is the operator that submits `settle_intent_with_chain2_verification`
# for Solana-source intents. The matching pubkey must be authorized on-chain
# via `add_relayer` (see solana/migrations/deploy.ts — set
# BRIDGE_INTENT_RELAYER_PUBKEY to the relayer's pubkey, then run
# `anchor migrate --provider.cluster devnet`).
# Generate with:
#   solana-keygen new --outfile relayer-solana.json
#   go run ./cmd/solana-key-to-base58 relayer-solana.json
RELAYER_SOLANA_PRIVATE_KEY=

# --- SPL Token Faucet (optional) ---
# Set FAUCET_SOLANA_PRIVATE_KEY to enable the /solana/faucet/* endpoints.
# The account must be the mint authority for FAUCET_TOKEN_MINT.
#
# Paste the raw output of: cat ~/.config/solana/id.json
# (the JSON byte array format, e.g. [108,219,39,...])
# OR use the base58-encoded secret key from `solana-keygen`.
FAUCET_SOLANA_PRIVATE_KEY=

# The SPL token mint address the faucet will mint from.
FAUCET_TOKEN_MINT=CLQdHANA2Z2tjka21NqBkzoytaH18JtA2Q56Bt4tHPj

# Token decimals (default 6; auto-detected from the chain at startup).
FAUCET_TOKEN_DECIMALS=6

# Solana RPC for faucet transactions. Falls back to the first configured
# Solana chain's RPC when unset.
FAUCET_SOLANA_RPC_URL=

# How many hours a wallet must wait between claims (default 24).
FAUCET_COOLDOWN_HOURS=24

# Optional: TEE Safe co-signers for EVM Safe-based ops (3 keys, hex without 0x).
SAFE_SIGNER_KEY_1=
SAFE_SIGNER_KEY_2=
SAFE_SIGNER_KEY_3=

# ECIES keypair used by the legacy EVM stealth flow. Auto-generated if blank
# (the relayer prints the generated key on first start).
ECIES_PRIVATE_KEY=

# Solver economics
MIN_PROFIT_MARGIN=0.02
MAX_BID_AMOUNT=1000000000000000000000
BID_INCREMENT=1000000000000000000
BALANCE_BUFFER=0.1
SOLVER_USER_DAILY_CAP_USD=0        # 0 disables the per-user $-cap

# Helius webhook auth — shared secret the relayer requires on
# /solana/helius-webhook posts. Set to a long random string and configure
# Helius to send `Authorization: <value>` (or `Authorization: Bearer <value>`).
HELIUS_WEBHOOK_AUTH=

# ============================================================================
# CHAIN 1 — Horizen mainnet (EVM)
# ============================================================================
CHAIN_1_NAME=horizen-mainnet
CHAIN_1_TYPE=evm
CHAIN_1_ID=26514
CHAIN_1_RPC=https://horizen.calderachain.xyz/http
CHAIN_1_BRIDGE=0x1809703DE921177cca0f1c80FB58D788E09AdDB4
CHAIN_1_EXPLORER=https://horizen.calderaexplorer.xyz
CHAIN_1_SAFE_ADDRESS=
CHAIN_1_MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11

# ============================================================================
# CHAIN 2 — Base mainnet (EVM)
# ============================================================================
CHAIN_2_NAME=base-mainnet
CHAIN_2_TYPE=evm
CHAIN_2_ID=8453
CHAIN_2_RPC=https://1rpc.io/base
CHAIN_2_BRIDGE=0x52F77B624a9f20d41a60eF550e5792a00747262c
CHAIN_2_EXPLORER=https://basescan.org
CHAIN_2_SAFE_ADDRESS=
CHAIN_2_MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11

# ============================================================================
# CHAIN 3 — Solana mainnet
#   ChainID is the LayerZero EID for Solana (30168 mainnet, 40168 devnet).
#   This keeps the cross-chain composite key (sourceChainId, intentId)
#   unique across both runtimes.
# ============================================================================
CHAIN_3_NAME=solana-mainnet
CHAIN_3_TYPE=solana
CHAIN_3_ID=30168
CHAIN_3_RPC=https://api.mainnet-beta.solana.com
CHAIN_3_HELIUS_RPC=                                  # wss://...helius-rpc.com/?api-key=... (optional, prefer when present)
CHAIN_3_EXPLORER=https://explorer.solana.com
CHAIN_3_SOLANA_PROGRAM_ID=64SZByfhWxvxu7haf153RHBvReNUFqz154RNagBbeYwk
CHAIN_3_SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
CHAIN_3_SOLANA_WSOL_MINT=So11111111111111111111111111111111111111112
CHAIN_3_SOLANA_COMMITMENT=confirmed                   # processed | confirmed | finalized
CHAIN_3_SOLANA_PRIORITY_FEE_MICROLAMPORTS=10000      # 0 disables priority-fee compute-unit price ix

# ============================================================================
# CHAIN 4 — Solana devnet (uncomment + bump CHAIN_COUNT to 4)
# ============================================================================
#CHAIN_4_NAME=solana-devnet
#CHAIN_4_TYPE=solana
#CHAIN_4_ID=40168
#CHAIN_4_RPC=https://api.devnet.solana.com
#CHAIN_4_HELIUS_RPC=
#CHAIN_4_EXPLORER=https://explorer.solana.com?cluster=devnet
