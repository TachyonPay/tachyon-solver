# Tachyon Solver/Relayer Docker Environment Configuration
# Copy this to .env and fill in your values

# =============================================================================
# REQUIRED: Wallet Configuration
# =============================================================================
# EOA that pays gas for all transactions (does NOT need to be a Safe owner)
PRIVATE_KEY=your_private_key_here_without_0x_prefix
ECIES_PRIVATE_KEY=your_ecies_private_key_here

# =============================================================================
# Safe TEE Signing Keys (required if any chain has SAFE_ADDRESS set)
# =============================================================================
# These 3 keys are held inside the TEE. They are all owners of the Gnosis Safe
# and together reach the signing threshold (3-of-6). All 3 sign every Safe tx;
# signatures are sorted by owner address ascending before submission.
SAFE_SIGNER_KEY_1=tee_signer_key_1_no_0x_prefix
SAFE_SIGNER_KEY_2=tee_signer_key_2_no_0x_prefix
SAFE_SIGNER_KEY_3=tee_signer_key_3_no_0x_prefix

# =============================================================================
# Chain Configuration
# =============================================================================
CHAIN_COUNT=4

# Chain 1: Horizen Gobi Testnet
CHAIN_1_ID=845320009
CHAIN_1_NAME=horizen
CHAIN_1_RPC=https://gobi-testnet.horizenlabs.io/ethv1
CHAIN_1_BRIDGE=0x_your_horizen_bridge_address
CHAIN_1_EXPLORER=https://gobi-explorer.horizenlabs.io
CHAIN_1_SAFE_ADDRESS=0x_your_gnosis_safe_address_on_horizen  # Same Safe (same address, same owners)

# Chain 2: Base Sepolia
CHAIN_2_ID=84532
CHAIN_2_NAME=base
CHAIN_2_RPC=https://sepolia.base.org
CHAIN_2_BRIDGE=0x_your_base_bridge_address
CHAIN_2_EXPLORER=https://sepolia.basescan.org
CHAIN_2_SAFE_ADDRESS=0x_your_gnosis_safe_address_on_base  # Same Safe (same address, same owners)

# Chain 3: Ethereum Sepolia
CHAIN_3_ID=11155111
CHAIN_3_NAME=sepolia
CHAIN_3_RPC=https://ethereum-sepolia.rpc.subquery.network/public
CHAIN_3_BRIDGE=0x_your_sepolia_bridge_address
CHAIN_3_EXPLORER=https://sepolia.etherscan.io
# CHAIN_3_SAFE_ADDRESS=   # optional

# Chain 4: Rari Testnet
CHAIN_4_ID=1918988905
CHAIN_4_NAME=rari
CHAIN_4_RPC=https://rari-testnet.calderachain.xyz/http
CHAIN_4_BRIDGE=0x_your_rari_bridge_address
CHAIN_4_EXPLORER=https://rari-testnet.calderachain.xyz
# CHAIN_4_SAFE_ADDRESS=   # optional

# =============================================================================
# Service Configuration
# =============================================================================
SOLVER_PORT=8081
RELAYER_PORT=8080

# =============================================================================
# Solver Strategy Configuration
# =============================================================================
# Minimum profit margin (e.g., 0.02 = 2%)
MIN_PROFIT_MARGIN=0.02

# Maximum bid amount in wei (e.g., 1000 tokens with 18 decimals)
MAX_BID_AMOUNT=1000000000000000000000

# Bid increment for competitive bidding (in wei)
BID_INCREMENT=1000000000000000000

# Balance buffer to keep (e.g., 0.1 = keep 10% reserve)
BALANCE_BUFFER=0.1

# =============================================================================
# E2E Test Amount Configuration (raw token units, decimals applied automatically)
# =============================================================================
# Amount of TokenA the user deposits to create the intent
TEST_AMOUNT_A=100
# Amount of TokenB the user expects to receive on the destination chain
TEST_AMOUNT_B=95
# Solver incentive paid in TokenA on top of the deposit
TEST_REWARD=5
# How TEST_AMOUNT_B is split across the 3 stealth recipients (must sum to TEST_AMOUNT_B)
TEST_RECIPIENT_1_AMOUNT=30
TEST_RECIPIENT_2_AMOUNT=35
TEST_RECIPIENT_3_AMOUNT=30
