# Binaries
bin/
*.exe
*.dll
*.so
*.dylib

# Bare-named Go binaries compiled with `go build` (Mach-O on macOS, ELF on
# Linux — no extension on either). Each `cmd/<name>/main.go` produces a
# binary of the same name at THIS directory's root. The leading `/` is
# critical — without it, `relayer` and `solver` would also match the
# `pkg/relayer/` and `pkg/solver/` package directories, silently
# excluding any new .go files placed inside them.
/deploy-spl-test-tokens
/solana-key-to-base58
/relayer
/solver
/privacy-router
/test-relay-proxy
/verify-prediction
/fund-test-safe
/deploy-tee-safes
/deploy-test-safe
/safe-transfer-out
/test-safe-deploy

# Test binary, built with `go test -c`
*.test

# Solana keypair JSON files — these are 64-byte ed25519 SECRET keys, never commit.
# Solver / relayer wallets live here by default; back them up out-of-repo.
*-solana.json
solver-solana.json
relayer-solana.json

# Output of the go coverage tool
*.out

# Go workspace file
go.work



# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Dependency directories
vendor/
data/
